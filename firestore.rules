rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return (
        // Option A: Active authenticated session (if anonymous auth is enabled)
        (request.auth != null && (
          (exists(/databases/$(database)/documents/config/admin_session) &&
           'uid' in get(/databases/$(database)/documents/config/admin_session).data &&
           request.auth.uid == get(/databases/$(database)/documents/config/admin_session).data.uid &&
           'adminPassword' in get(/databases/$(database)/documents/config/admin_session).data &&
           get(/databases/$(database)/documents/config/admin_session).data.adminPassword in ['7340', '26304421', '7341']
          ) ||
          (exists(/databases/$(database)/documents/users/admin_tapp) &&
           'uid' in get(/databases/$(database)/documents/users/admin_tapp).data &&
           request.auth.uid == get(/databases/$(database)/documents/users/admin_tapp).data.uid) ||
          (exists(/databases/$(database)/documents/users/orinoco_admin) &&
           'uid' in get(/databases/$(database)/documents/users/orinoco_admin).data &&
           request.auth.uid == get(/databases/$(database)/documents/users/orinoco_admin).data.uid) ||
          (exists(/databases/$(database)/documents/users/kervin) &&
           'uid' in get(/databases/$(database)/documents/users/kervin).data &&
           request.auth.uid == get(/databases/$(database)/documents/users/kervin).data.uid) ||
          (exists(/databases/$(database)/documents/users/kervinjose022) &&
           'uid' in get(/databases/$(database)/documents/users/kervinjose022).data &&
           request.auth.uid == get(/databases/$(database)/documents/users/kervinjose022).data.uid)
        )) ||
        // Option B: Secure Password-only fallback with fresh timestamp validation (if anonymous auth is disabled)
        (exists(/databases/$(database)/documents/config/admin_session) &&
         'adminPassword' in get(/databases/$(database)/documents/config/admin_session).data &&
         get(/databases/$(database)/documents/config/admin_session).data.adminPassword in ['7340', '26304421', '7341']
        )
      );
    }

    // Collection: users
    match /users/{username} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() || 
                    (username in ['admin_tapp', 'orinoco_admin', 'kervin', 'kervinjose022'] && isSignedIn()) || 
                    (
                      request.resource.data.vipLevel == resource.data.vipLevel &&
                      request.resource.data.status == resource.data.status &&
                      (
                        // User can decrease their earnings (withdrawal)
                        (request.resource.data.earnings < resource.data.earnings) ||
                        // User can increase their earnings by up to 2500.0 coins per update (task completion)
                        (
                          (request.resource.data.earnings - resource.data.earnings >= 0) &&
                          (request.resource.data.earnings - resource.data.earnings <= 2500.0)
                        ) ||
                        // Or earnings stay exactly the same (e.g. password, wallet, or other info updates)
                        (request.resource.data.earnings == resource.data.earnings)
                      )
                    );
      allow delete: if isAdmin();
    }

    // Collection: registrations
    match /registrations/{registrationId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() || (
                      request.resource.data.status in ['pending', 'pendiente', 'Pendiente'] &&
                      resource.data.status in ['pending', 'pendiente', 'Pendiente']
                    );
      allow delete: if isAdmin();
    }

    // Collection: withdrawals
    match /withdrawals/{withdrawalId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Collection: voices
    match /voices/{voiceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Collection: reels
    match /reels/{reelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Collection: config
    match /config/admin_session {
      allow read, write: if true;
    }
    match /config/{configId} {
      allow read: if true;
      allow write: if configId != 'admin_session' && isAdmin();
    }

    // Collection: recovery_requests
    match /recovery_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
