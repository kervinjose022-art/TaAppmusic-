rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/config/admin_session) &&
             request.auth.uid == get(/databases/$(database)/documents/config/admin_session).data.uid;
    }

    // Collection: users
    match /users/{username} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() || (
                      request.resource.data.vipLevel == resource.data.vipLevel &&
                      (
                        // User can decrease their earnings (withdrawal)
                        (request.resource.data.earnings < resource.data.earnings) ||
                        // User can increase their earnings by up to 10.0 coins per update (task completion)
                        (
                          (request.resource.data.earnings - resource.data.earnings >= 0) &&
                          (request.resource.data.earnings - resource.data.earnings <= 10.0)
                        )
                      )
                    );
      allow delete: if isAdmin();
    }

    // Collection: registrations
    match /registrations/{registrationId} {
      allow read: if true;
      allow create: if request.resource.data.status in ['pending', 'pendiente', 'Pendiente'];
      allow update: if isAdmin() || (
                      request.resource.data.status in ['pending', 'pendiente', 'Pendiente'] &&
                      resource.data.status in ['pending', 'pendiente', 'Pendiente']
                    );
      allow delete: if isAdmin();
    }

    // Collection: withdrawals
    match /withdrawals/{withdrawalId} {
      allow read: if true;
      allow create: if request.resource.data.status in ['pending', 'pendiente', 'Pendiente'];
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Collection: voices
    match /voices/{voiceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Collection: reels
    match /reels/{reelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Collection: config
    match /config/{configId} {
      allow read: if true;
      allow write: if (configId == 'admin_session' && request.resource.data.adminPassword in ['7340', '26394421', '26304421']) || isAdmin();
    }

    // Collection: recovery_requests
    match /recovery_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
