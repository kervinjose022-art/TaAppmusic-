rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/config/admin_session) &&
         request.auth.uid == get(/databases/$(database)/documents/config/admin_session).data.uid) ||
        (exists(/databases/$(database)/documents/users/admin_tapp) &&
         request.auth.uid == get(/databases/$(database)/documents/users/admin_tapp).data.uid) ||
        (exists(/databases/$(database)/documents/users/orinoco_admin) &&
         request.auth.uid == get(/databases/$(database)/documents/users/orinoco_admin).data.uid)
      );
    }

    // Collection: users
    match /users/{username} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() || (
                      request.resource.data.vipLevel == resource.data.vipLevel &&
                      request.resource.data.status == resource.data.status &&
                      (
                        // User can decrease their earnings (withdrawal)
                        (request.resource.data.earnings < resource.data.earnings) ||
                        // User can increase their earnings by up to 15.0 coins per update (task completion)
                        (
                          (request.resource.data.earnings - resource.data.earnings >= 0) &&
                          (request.resource.data.earnings - resource.data.earnings <= 15.0)
                        ) ||
                        // Or earnings stay exactly the same (e.g. password, wallet, or other info updates)
                        (request.resource.data.earnings == resource.data.earnings)
                      )
                    );
      allow delete: if isAdmin();
    }

    // Collection: registrations
    match /registrations/{registrationId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() || (
                      request.resource.data.status in ['pending', 'pendiente', 'Pendiente'] &&
                      resource.data.status in ['pending', 'pendiente', 'Pendiente']
                    );
      allow delete: if isAdmin();
    }

    // Collection: withdrawals
    match /withdrawals/{withdrawalId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Collection: voices
    match /voices/{voiceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Collection: reels
    match /reels/{reelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Collection: config
    match /config/{configId} {
      allow read: if true;
      allow write: if (configId == 'admin_session') || isAdmin();
    }

    // Collection: recovery_requests
    match /recovery_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
